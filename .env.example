# Variables de entorno para el Agente TAG de Exoplanetas (DuckDB + Groq)
# Copia este archivo con el nombre .env y coloca tu credencial real:
# cp .env.example .env

# Clave de API de Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEY="tu_api_key_de_groq"

# Modelo de lenguaje en Groq para síntesis de SQL y generación fundamentada
MODELO_GROQ="openai/gpt-oss-120b"
